{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "test:acceptance": {},
    "bench": {
      "cache": false
    },
    "@budget/query-planner#bench": {
      "cache": false,
      "dependsOn": ["@budget/grid#bench", "@budget/timeline#bench"]
    }
  }
}
