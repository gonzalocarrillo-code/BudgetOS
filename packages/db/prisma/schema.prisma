generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy & identity ----------
model Organization {
  id         String      @id @db.Uuid
  name       String
  workspaces Workspace[]
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  /// W3-2 (ADR-0081): org-level Idempotency-Key rows; they cascade with the org.
  idempotencyKeys IdempotencyKey[]
  /// R11-002: `slack` is the Slack team every workspace of the org answers to.
  settings   Json        @default("{}")

  @@map("organization")
}

model Workspace {
  id                   String       @id @db.Uuid
  orgId                String       @map("org_id") @db.Uuid
  org                  Organization @relation(fields: [orgId], references: [id])
  slug                 String
  name                 String
  reportingCurrency    String       @map("reporting_currency") @db.Char(3)
  fiscalYearStartMonth Int          @default(1) @map("fiscal_year_start_month")
  settings             Json         @default("{}")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz
  /// ACTIVE | ARCHIVED (ADR-052): archived is read-only and seen by superadmins only.
  status               String       @default("ACTIVE")
  archivedAt           DateTime?    @map("archived_at") @db.Timestamptz
  archivedBy           String?      @map("archived_by") @db.Uuid
  /// Deleted by a superadmin: a tombstone; the purge worker removes its rows after purgeAfter.
  deletedAt            DateTime?    @map("deleted_at") @db.Timestamptz
  purgeAfter           DateTime?    @map("purge_after") @db.Timestamptz
  purgedAt             DateTime?    @map("purged_at") @db.Timestamptz
  /// W1-5 (ADR-0072): previews are ephemeral staging; they cascade when the workspace is deleted.
  bulkPreviews         BulkPreview[]
  /// W3-2 (ADR-0081): Idempotency-Key replays are ephemeral; they cascade when the workspace is deleted.
  idempotencyKeys      IdempotencyKey[]

  // W3-11 (audit I-32): back-relations for the workspace_id -> workspace(id) FK every tenant table
  // now has. No query uses these lists (the app always filters the child table directly under
  // RLS); they exist only because Prisma requires both sides of a relation to be declared.
  roleAssignments     RoleAssignment[]
  dimensions          Dimension[]
  hierarchyTemplates  HierarchyTemplate[]
  fiscalPeriods       FiscalPeriod[]
  envelopes           Envelope[]
  envelopeLineages    EnvelopeLineage[]
  targets             Target[]
  approvalPolicies    ApprovalPolicy[]
  approvalRequests    ApprovalRequest[]
  pacingRules         PacingRule[]
  alerts              Alert[]
  threads             Thread[]
  tags                Tag[]
  taggables           Taggable[]
  savedViews          SavedView[]
  periodClosures      PeriodClosure[]
  dataSources         DataSource[]
  exportJobs          ExportJob[]
  commentReactions    CommentReaction[]
  namingTemplates     NamingTemplate[]
  experiments         Experiment[]
  experimentEnvelopes ExperimentEnvelope[]
  manualEntryBatches  ManualEntryBatch[]
  manualEntryFacts    ManualEntryFact[]
  tours               Tour[]
  envelopeAllocations EnvelopeAllocation[]
  budgetBaselines     BudgetBaseline[]
  mappingProfiles     MappingProfile[]
  mappingSynonyms     MappingSynonym[]
  matchRules          MatchRule[]
  metricDefinitions   MetricDefinition[]

  @@unique([orgId, slug])
  @@map("workspace")
}

model User {
  id          String   @id @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  email       String   @unique
  name        String
  googleSub   String?  @unique @map("google_sub")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// Round 11 (PR 1): last successful sign-in, written by app_record_sign_in(). Null until the
  /// person's first sign-in, so the Roles/org-console UI can show "Invited, not signed in yet".
  lastSignInAt DateTime? @map("last_sign_in_at") @db.Timestamptz
  /// The person's own settings (S-010): `slack.defaultWorkspaceId`. Written only through app_set_my_slack_settings.
  settings    Json     @default("{}")
  /// S-14 (ADR-075): the Slack user id this app user's identity is pinned to, set on first contact
  /// by app_link_my_slack_user. A partial unique index (org_id, slack_user_id) in the migration
  /// (not representable here) keeps one Slack account from pinning to two app users of an org.
  slackUserId String?       @map("slack_user_id")
  sessions    AuthSession[]

  @@map("app_user")
}

model Group {
  id          String        @id @db.Uuid
  orgId       String        @map("org_id") @db.Uuid
  googleGroup String        @map("google_group") // e.g. latam-media-leads@dept.com
  name        String
  members     GroupMember[]

  @@unique([orgId, googleGroup])
  @@map("app_group")
}

model GroupMember {
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  group    Group    @relation(fields: [groupId], references: [id])
  syncedAt DateTime @default(now()) @map("synced_at") @db.Timestamptz

  @@id([groupId, userId])
  @@map("app_group_member")
}

enum Role {
  VIEWER
  PLANNER
  BUDGET_OWNER
  APPROVER
  FINANCE
  DATA_ADMIN
  WORKSPACE_ADMIN
  ORG_ADMIN
}

model RoleAssignment {
  id            String     @id @db.Uuid
  workspaceId   String?    @map("workspace_id") @db.Uuid // null => org-wide (ORG_ADMIN only)
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  principalType String     @map("principal_type") // 'user' | 'group'
  principalId   String     @map("principal_id") @db.Uuid
  role          Role
  scope         Json       @default("{}") // FilterGroup or {} = whole workspace
  createdBy     String     @map("created_by") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, principalId])
  /// W3-3 (audit I-19): two partial unique indexes, role_assignment_unique_scoped
  /// (workspace_id, principal_type, principal_id, role) WHERE workspace_id IS NOT NULL and
  /// role_assignment_unique_org_wide (principal_type, principal_id, role) WHERE workspace_id IS
  /// NULL -- not representable as @@unique (no partial-index attribute, and NULL workspace_id needs
  /// its own index since Postgres treats every NULL as distinct); enforced in
  /// 20261015010000_partial_unique_constraints/migration.sql.
  @@map("role_assignment")
}

// ---------- Registry (§4.2) ----------
enum DimensionDataType {
  ENUM
  TEXT
  REFERENCE
  DATE_BUCKET
}

model Dimension {
  id                 String              @id @db.Uuid
  orgId              String              @map("org_id") @db.Uuid
  workspaceId        String?             @map("workspace_id") @db.Uuid // null = org-wide default
  workspace          Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  key                String
  label              String
  description        String?
  dataType           DimensionDataType   @map("data_type")
  icon               String              @default("lucide:tag") // 'lucide:<name>' | 'asset:<gcs-object>'
  color              String?
  allowedParents     String[]            @default([]) @map("allowed_parents") // dimension keys
  isRequiredForLeaf  Boolean             @default(false) @map("is_required_for_leaf")
  sortOrder          Int                 @default(0) @map("sort_order")
  isActive           Boolean             @default(true) @map("is_active")
  version            Int                 @default(1)
  createdBy          String              @map("created_by") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  values             DimensionValue[]
  envelopeDimensions EnvelopeDimension[]

  @@unique([orgId, workspaceId, key])
  @@map("dimension")
}

model DimensionValue {
  id                 String               @id @db.Uuid
  dimensionId        String               @map("dimension_id") @db.Uuid
  dimension          Dimension            @relation(fields: [dimensionId], references: [id])
  code               String
  label              String
  parentValueId      String?              @map("parent_value_id") @db.Uuid
  /// W3-11 (audit I-32): self-referencing FK, RESTRICT. The workspace purge nulls parentValueId
  /// and mergedIntoId for a dimension's values before deleting them (a single DELETE statement
  /// cannot satisfy a self-reference row-by-row in an arbitrary order).
  parent             DimensionValue?      @relation("DimensionValueParent", fields: [parentValueId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children           DimensionValue[]     @relation("DimensionValueParent")
  path               Unsupported("ltree") // set by trigger from parent chain; e.g. 'emea.de'
  aliases            String[]             @default([])
  externalIds        Json                 @default("{}") @map("external_ids")
  isActive           Boolean              @default(true) @map("is_active")
  retiredAt          DateTime?            @map("retired_at") @db.Timestamptz
  mergedIntoId       String?              @map("merged_into_id") @db.Uuid
  mergedInto         DimensionValue?      @relation("DimensionValueMergedInto", fields: [mergedIntoId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  mergedFrom         DimensionValue[]     @relation("DimensionValueMergedInto")
  envelopeDimensions EnvelopeDimension[]

  @@unique([dimensionId, code])
  @@index([dimensionId, parentValueId])
  @@map("dimension_value")
}

model HierarchyTemplate {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name        String
  path        String[]  @default([]) // ['client','region','country','platform','objective']
  isDefault   Boolean   @default(false) @map("is_default")
  version     Int       @default(1)
  createdBy   String    @map("created_by") @db.Uuid

  @@unique([workspaceId, name])
  @@map("hierarchy_template")
}

model ValueConstraint {
  id                String   @id @db.Uuid
  dimensionId       String   @map("dimension_id") @db.Uuid
  whenDimensionKey  String   @map("when_dimension_key")
  whenValueCode     String   @map("when_value_code")
  allowedValueCodes String[] @default([]) @map("allowed_value_codes")

  @@map("value_constraint")
}

model FiscalPeriod {
  id             String          @id @db.Uuid
  workspaceId    String          @map("workspace_id") @db.Uuid
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  key            String // '2026-Q4', '2026-11', 'FY26'
  kind           String // month | quarter | year | custom
  startDate      DateTime        @map("start_date") @db.Date
  endDate        DateTime        @map("end_date") @db.Date
  periodClosures PeriodClosure[]

  @@unique([workspaceId, key])
  @@map("fiscal_period")
}

// ---------- Envelopes (§4.3) ----------
enum EnvelopeStatus {
  DRAFT
  PENDING
  APPROVED
  LOCKED
  ARCHIVED
}

enum VersionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
  WITHDRAWN
}

enum AmountType {
  BUDGET
  COMMITTED
  FORECAST
  SCENARIO
}

model Envelope {
  id                  String               @id @db.Uuid
  workspaceId         String               @map("workspace_id") @db.Uuid
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  parentId            String?              @map("parent_id") @db.Uuid
  /// W3-11 (audit I-32): was ON DELETE SET NULL (silently reparented children to the root on a
  /// hard delete); now RESTRICT. The workspace purge nulls parentId for every envelope in the
  /// workspace before deleting them (apps/workers/src/purge/purge.ts).
  parent              Envelope?            @relation("EnvelopeTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children            Envelope[]           @relation("EnvelopeTree")
  name                String
  /// Renamed by someone: the display naming template leaves it alone.
  nameCustom          Boolean              @default(false) @map("name_custom")
  dimensionValues     Json                 @map("dimension_values") // {"country":"BR","platform":"meta"} — denormalised copy
  periodId            String?              @map("period_id") @db.Uuid
  startDate           DateTime             @map("start_date") @db.Date
  endDate             DateTime             @map("end_date") @db.Date
  currency            String               @db.Char(3)
  status              EnvelopeStatus       @default(DRAFT)
  ownerId             String?              @map("owner_id") @db.Uuid
  allowOverAllocation Boolean              @default(false) @map("allow_over_allocation")
  currentVersionId    String?              @map("current_version_id") @db.Uuid // latest APPROVED
  draftVersionId      String?              @map("draft_version_id") @db.Uuid // open draft, if any
  rowVersion          Int                  @default(1) @map("row_version") // optimistic concurrency for metadata edits
  /// T-036: rendered by the active naming templates (§24.2); the tuple stays the identity.
  displayName         String?              @map("display_name")
  matchKey            String?              @map("match_key")
  createdBy           String               @map("created_by") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  /// W3-11 (audit I-32): DEFERRABLE INITIALLY DEFERRED (SQL-only; Prisma cannot express
  /// deferrability) — envelopeVersion.envelopeId -> envelope already exists, so a version names
  /// its envelope before the envelope ever points back at it. The workspace purge nulls both
  /// pointers before deleting the envelope's versions (purge.ts).
  currentVersion      EnvelopeVersion?     @relation("EnvelopeCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  draftVersion        EnvelopeVersion?     @relation("EnvelopeDraftVersion", fields: [draftVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  versions            EnvelopeVersion[]    @relation("EnvelopeVersions")
  dims                EnvelopeDimension[]
  alerts              Alert[]
  targets             Target[]
  closureEnvelopes    ClosureEnvelope[]
  /// T-040: written by the demo dataset; the purge deletes these rows.
  demo                Boolean              @default(false)
  /// Phase E (ADR-053): stopped early on end_date with its final amount; read-only after.
  endedAt             DateTime?            @map("ended_at") @db.Timestamptz
  endedBy             String?              @map("ended_by") @db.Uuid
  endedReason         String?              @map("ended_reason")
  allocationsAsParent EnvelopeAllocation[] @relation("AllocationParent")
  allocationsAsChild  EnvelopeAllocation[] @relation("AllocationChild")
  matchRules          MatchRule[]

  @@index([workspaceId, parentId])
  @@index([workspaceId, startDate, endDate])
  @@index([workspaceId, matchKey], map: "envelope_match_key_idx")
  @@map("envelope")
}

model EnvelopeDimension {
  envelopeId  String         @map("envelope_id") @db.Uuid
  dimensionId String         @map("dimension_id") @db.Uuid
  valueId     String         @map("value_id") @db.Uuid
  envelope    Envelope       @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  /// W3-11 (audit I-32): was unenforced.
  dimension   Dimension      @relation(fields: [dimensionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  value       DimensionValue @relation(fields: [valueId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([envelopeId, dimensionId])
  @@index([dimensionId, valueId, envelopeId])
  @@map("envelope_dimension")
}

model EnvelopeVersion {
  id               String            @id @db.Uuid
  envelopeId       String            @map("envelope_id") @db.Uuid
  envelope         Envelope          @relation("EnvelopeVersions", fields: [envelopeId], references: [id])
  /// Back-relations for envelope.currentVersionId / draftVersionId, required once there is more
  /// than one relation between Envelope and EnvelopeVersion (Prisma then requires every one named).
  envelopesCurrent Envelope[]        @relation("EnvelopeCurrentVersion")
  envelopesDraft   Envelope[]        @relation("EnvelopeDraftVersion")
  versionNo        Int               @map("version_no")
  amountType       AmountType        @default(BUDGET) @map("amount_type")
  amount           Decimal           @db.Decimal(18, 2) // envelope currency
  amountReporting  Decimal           @map("amount_reporting") @db.Decimal(18, 2)
  fxRateId         String?           @map("fx_rate_id") @db.Uuid
  status           VersionStatus     @default(DRAFT)
  basedOnVersionId String?           @map("based_on_version_id") @db.Uuid
  rationale        String?
  attachments      Json              @default("[]")
  formula          Json? // Phase 2
  createdBy        String            @map("created_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  approvedAt       DateTime?         @map("approved_at") @db.Timestamptz
  supersededAt     DateTime?         @map("superseded_at") @db.Timestamptz
  phasing          EnvelopePhasing[]
  /// T-040: written by the demo dataset; the purge deletes these rows.
  demo             Boolean           @default(false)

  @@unique([envelopeId, versionNo])
  @@index([envelopeId, status, approvedAt])
  @@map("envelope_version")
}

model EnvelopePhasing {
  versionId String          @map("version_id") @db.Uuid
  version   EnvelopeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  month     DateTime        @db.Date // first day of month
  amount    Decimal         @db.Decimal(18, 2)

  @@id([versionId, month])
  @@map("envelope_phasing")
}

model EnvelopeLineage {
  id             String    @id @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  fromEnvelopeId String    @map("from_envelope_id") @db.Uuid
  toEnvelopeId   String    @map("to_envelope_id") @db.Uuid
  kind           String // move | split | merge | continues (H-012)
  versionId      String?   @map("version_id") @db.Uuid
  actorId        String    @map("actor_id") @db.Uuid
  at             DateTime  @default(now()) @db.Timestamptz

  @@index([fromEnvelopeId])
  @@index([toEnvelopeId])
  /// W3-3 (audit I-28): partial unique index envelope_lineage_continues_source (from_envelope_id)
  /// WHERE kind='continues' -- one successor per ended budget; not representable as @@unique (no
  /// partial-index attribute); enforced in 20261015010000_partial_unique_constraints/migration.sql.
  @@map("envelope_lineage")
}

model FxRate {
  id       String   @id @db.Uuid
  base     String   @db.Char(3)
  quote    String   @db.Char(3)
  rate     Decimal  @db.Decimal(18, 8)
  asOfDate DateTime @map("as_of_date") @db.Date
  source   String

  @@unique([base, quote, asOfDate])
  @@map("fx_rate")
}

// ---------- Targets (§4.8) ----------
model MetricDefinition {
  id          String     @id @db.Uuid
  orgId       String     @map("org_id") @db.Uuid
  /// ORG-007: set for a workspace's own metric; null for the shared library (superadmins).
  workspaceId String?    @map("workspace_id") @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  key         String // budget | cpa | cpl | roas | cpm | cpc | ctr | conversions | revenue | ...
  label       String
  numerator   String // 'spend' | 'kpi:<metric>' | 'budget'
  denominator String? // null => plain sum
  direction   String // lower_is_better | higher_is_better
  format      String // currency | number | percent | ratio
  unit        String?
  multiplier  Decimal    @default(1) @db.Decimal // applied after the division: cpm = spend / impressions × 1000
  isActive    Boolean    @default(true) @map("is_active")

  @@unique([orgId, key])
  @@map("metric_definition")
}

model Target {
  id               String          @id @db.Uuid
  workspaceId      String          @map("workspace_id") @db.Uuid
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  scopeType        String          @map("scope_type") // envelope | filter
  envelopeId       String?         @map("envelope_id") @db.Uuid
  /// W3-11 (audit I-32): was unenforced (nullable: scopeType "filter" has none).
  envelope         Envelope?       @relation(fields: [envelopeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  scopeFilter      Json?           @map("scope_filter") // FilterGroup
  metricKey        String          @map("metric_key")
  startDate        DateTime        @map("start_date") @db.Date
  endDate          DateTime        @map("end_date") @db.Date
  ownerId          String?         @map("owner_id") @db.Uuid
  status           String          @default("active")
  currentVersionId String?         @map("current_version_id") @db.Uuid
  draftVersionId   String?         @map("draft_version_id") @db.Uuid
  /// W3-11: not deferred, unlike envelope's — target-writer.ts always creates the target with both
  /// pointers NULL and sets them in a later UPDATE once the version exists.
  currentVersion   TargetVersion?  @relation("TargetCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  draftVersion     TargetVersion?  @relation("TargetDraftVersion", fields: [draftVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  versions         TargetVersion[] @relation("TargetVersions")
  /// T-040: written by the demo dataset; the purge deletes these rows.
  demo             Boolean         @default(false)

  @@index([workspaceId, envelopeId, metricKey])
  /// W3-3 (audit I-19): partial unique index target_envelope_active_metric (envelope_id, metric_key)
  /// WHERE status='active' -- not representable as @@unique (no partial-index attribute);
  /// enforced in 20261015010000_partial_unique_constraints/migration.sql.
  @@map("target")
}

model TargetVersion {
  id                String        @id @db.Uuid
  targetId          String        @map("target_id") @db.Uuid
  target            Target        @relation("TargetVersions", fields: [targetId], references: [id])
  /// Back-relations for target.currentVersionId / draftVersionId (see EnvelopeVersion's equivalent).
  targetsCurrent    Target[]      @relation("TargetCurrentVersion")
  targetsDraft      Target[]      @relation("TargetDraftVersion")
  versionNo         Int           @map("version_no")
  value             Decimal       @db.Decimal(18, 4)
  comparator        String // lte | gte | eq | between
  valueUpper        Decimal?      @map("value_upper") @db.Decimal(18, 4)
  currency          String?       @db.Char(3)
  rationale         String?
  source            String        @default("manual") // manual | sheet | snowflake | derived
  status            VersionStatus @default(DRAFT)
  approvalRequestId String?       @map("approval_request_id") @db.Uuid
  createdBy         String        @map("created_by") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  approvedAt        DateTime?     @map("approved_at") @db.Timestamptz
  /// T-040: written by the demo dataset; the purge deletes these rows.
  demo              Boolean       @default(false)

  @@unique([targetId, versionNo])
  @@map("target_version")
}

// ---------- Approvals (§8.1–8.2) ----------
model ApprovalPolicy {
  id                    String    @id @db.Uuid
  workspaceId           String    @map("workspace_id") @db.Uuid
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name                  String
  priority              Int
  conditions            Json // see §9.1 of this spec
  chain                 Json // [{ role, groupId?, minApprovals, timeoutHours, escalateTo? }]
  allowExternalEvidence Boolean   @default(false) @map("allow_external_evidence")
  blockSelfApproval     Boolean   @default(true) @map("block_self_approval")
  version               Int       @default(1)
  isActive              Boolean   @default(true) @map("is_active")

  @@unique([workspaceId, name])
  @@index([workspaceId, priority])
  @@map("approval_policy")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  WITHDRAWN
  ESCALATED
}

model ApprovalRequest {
  id             String             @id @db.Uuid
  workspaceId    String             @map("workspace_id") @db.Uuid
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  entityType     String             @map("entity_type") // envelope_version | target_version | bulk_change
  entityId       String             @map("entity_id") @db.Uuid
  policyId       String             @map("policy_id") @db.Uuid
  policyVersion  Int                @map("policy_version")
  policySnapshot Json               @map("policy_snapshot") // frozen copy of chain+conditions
  currentStep    Int                @default(0) @map("current_step")
  status         RequestStatus      @default(PENDING)
  summary        String
  requestedBy    String             @map("requested_by") @db.Uuid
  requestedAt    DateTime           @default(now()) @map("requested_at") @db.Timestamptz
  dueAt          DateTime?          @map("due_at") @db.Timestamptz
  resolvedAt     DateTime?          @map("resolved_at") @db.Timestamptz
  decisions      ApprovalDecision[]

  @@index([workspaceId, status, dueAt])
  @@index([entityType, entityId])
  @@map("approval_request")
}

model ApprovalDecision {
  id        String          @id @db.Uuid
  requestId String          @map("request_id") @db.Uuid
  request   ApprovalRequest @relation(fields: [requestId], references: [id])
  stepIndex Int             @map("step_index")
  decidedBy String          @map("decided_by") @db.Uuid
  decision  String // approve | reject | request_changes | external_evidence
  comment   String?
  evidence  Json? // { gcsUri, sha256, approverName, approvedOn }
  channel   String          @default("app") // app | slack | email | external_upload
  decidedAt DateTime        @default(now()) @map("decided_at") @db.Timestamptz

  @@index([requestId, stepIndex])
  /// W3-11 (audit I-38): the approver-history lookup (who decided what on this request).
  @@index([requestId, decidedBy], map: "approval_decision_request_decider")
  /// W3-3 (audit I-18): unique index approval_decision_request_step_decider (request_id, step_index,
  /// decided_by) -- one decision per decider per step, so countedApprovals (COUNT(DISTINCT
  /// decided_by)) and the row count agree; enforced in
  /// 20261015010000_partial_unique_constraints/migration.sql.
  @@map("approval_decision")
}

// ---------- Pacing (§8.4) ----------
model PacingRule {
  id              String    @id @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name            String
  scope           Json      @default("{}") // FilterGroup
  metric          String // pace_index | projected_close_pct | kpi_vs_target_pct | ...
  metricArgs      Json      @default("{}") @map("metric_args") // e.g. { "metricKey": "cpa" }
  comparator      String // gt | gte | lt | lte
  threshold       Decimal   @db.Decimal(18, 4)
  consecutiveDays Int       @default(1) @map("consecutive_days")
  severity        String // info | warning | critical | data
  delivery        Json      @default("{\"inApp\":true}") // { inApp, slackChannel?, emails? }
  isActive        Boolean   @default(true) @map("is_active")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  alerts          Alert[]

  /// W3-3 (audit I-19): partial unique index pacing_rule_workspace_live_name (workspace_id, name)
  /// WHERE deleted_at IS NULL -- not representable as @@unique (no partial-index attribute);
  /// enforced in 20261015010000_partial_unique_constraints/migration.sql.
  @@map("pacing_rule")
}

model RuleState {
  ruleId          String   @map("rule_id") @db.Uuid
  envelopeId      String   @map("envelope_id") @db.Uuid
  consecutiveDays Int      @default(0) @map("consecutive_days")
  lastEvalDate    DateTime @map("last_eval_date") @db.Date
  lastValue       Decimal? @map("last_value") @db.Decimal(18, 4)
  priorDays       Int      @default(0) @map("prior_days") // breach streak through the day before lastEvalDate (ADR-012)

  @@id([ruleId, envelopeId])
  @@map("rule_state")
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  SNOOZED
  RESOLVED
}

model Alert {
  id           String      @id @db.Uuid
  workspaceId  String      @map("workspace_id") @db.Uuid
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ruleId       String      @map("rule_id") @db.Uuid
  rule         PacingRule  @relation(fields: [ruleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  envelopeId   String      @map("envelope_id") @db.Uuid
  envelope     Envelope    @relation(fields: [envelopeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  severity     String
  status       AlertStatus @default(OPEN)
  metricValue  Decimal     @map("metric_value") @db.Decimal(18, 4)
  threshold    Decimal     @db.Decimal(18, 4)
  context      Json // { budget, actual, projected, target?, dataAsOf }
  ownerId      String?     @map("owner_id") @db.Uuid
  openedAt     DateTime    @default(now()) @map("opened_at") @db.Timestamptz
  snoozedUntil DateTime?   @map("snoozed_until") @db.Timestamptz
  resolvedAt   DateTime?   @map("resolved_at") @db.Timestamptz

  @@unique([ruleId, envelopeId, openedAt])
  @@index([workspaceId, status, severity])
  @@map("alert")
}

// ---------- Collaboration (§8.6) ----------
model Thread {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  anchorType  String    @map("anchor_type") // envelope | envelope_version | target | approval_request | alert | closure | dimension_value | cell | diff_field
  anchorId    String    @map("anchor_id") @db.Uuid
  anchorMeta  Json      @default("{}") @map("anchor_meta") // cell: { month }, diff_field: { field }
  title       String?
  status      String    @default("open") // open | resolved
  isBlocking  Boolean   @default(false) @map("is_blocking")
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  resolvedBy  String?   @map("resolved_by") @db.Uuid
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz
  comments    Comment[]

  @@index([workspaceId, anchorType, anchorId])
  @@map("thread")
}

model Comment {
  id              String            @id @db.Uuid
  threadId        String            @map("thread_id") @db.Uuid
  thread          Thread            @relation(fields: [threadId], references: [id])
  reactions       CommentReaction[]
  parentCommentId String?           @map("parent_comment_id") @db.Uuid
  authorId        String            @map("author_id") @db.Uuid
  bodyMd          String            @map("body_md")
  mentions        Json              @default("[]") // [{ type:'user'|'group', id }]
  references      Json              @default("[]") // [{ type:'envelope'|'target'|'alert'|'request', id }]
  attachments     Json              @default("[]")
  editHistory     Json              @default("[]") @map("edit_history")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  editedAt        DateTime?         @map("edited_at") @db.Timestamptz
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz

  @@index([threadId, createdAt])
  @@map("comment")
}

/// An emoji reaction on a comment, by one account (plan §8.6, 0.6). One row per (comment, user, emoji).
model CommentReaction {
  commentId   String    @map("comment_id") @db.Uuid
  comment     Comment   @relation(fields: [commentId], references: [id])
  userId      String    @map("user_id") @db.Uuid
  emoji       String
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@id([commentId, userId, emoji])
  @@index([workspaceId, commentId])
  @@map("comment_reaction")
}

model Tag {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name        String
  color       String?
  kind        String    @default("label") // label | status | team | custom
  createdBy   String    @map("created_by") @db.Uuid

  @@unique([workspaceId, name])
  @@map("tag")
}

model Taggable {
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tagId       String    @map("tag_id") @db.Uuid
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id") @db.Uuid
  taggedBy    String    @map("tagged_by") @db.Uuid
  taggedAt    DateTime  @default(now()) @map("tagged_at") @db.Timestamptz

  @@id([tagId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("taggable")
}

model SavedView {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name        String
  screen      String // explorer | alerts | approvals | targets | report
  definition  Json // { filter, groupBy, measures, period, grain, columns, sort }
  visibility  String    @default("private") // private | shared | workspace_default
  sharedWith  Json      @default("[]") @map("shared_with")
  createdBy   String    @map("created_by") @db.Uuid

  @@map("saved_view")
}

// ---------- Exports (plan §6.2, spec §17) ----------
model ExportJob {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  kind        String // csv | xlsx | sheets
  status      String    @default("queued") // queued | running | done | failed
  query       Json // QueryRequest with the requester's read scope ANDed into filter; cursor / limit dropped
  filename    String
  objectUri   String?   @map("object_uri")
  rowCount    Int?      @map("row_count")
  error       String?
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  /// W3-4 (audit I-9): set when the job is claimed and refreshed after the object is written; a
  /// `running` job whose lease expired is stuck (the worker died) and the sweeper fails it.
  leaseUntil  DateTime? @map("lease_until") @db.Timestamptz
  heartbeatAt DateTime? @map("heartbeat_at") @db.Timestamptz

  @@index([workspaceId, createdBy, createdAt])
  @@map("export_job")
}

// ---------- Closures & ingestion (§4.5, §6.1) ----------
model PeriodClosure {
  id              String            @id @db.Uuid
  workspaceId     String            @map("workspace_id") @db.Uuid
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  periodId        String            @map("period_id") @db.Uuid
  /// W3-11 (audit I-32): was unenforced.
  period          FiscalPeriod      @relation(fields: [periodId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  status          String            @default("closed") // closing | closed | failed | restated (W3-1, ADR-018 addendum)
  closedBy        String            @map("closed_by") @db.Uuid
  /// When the close started while `closing`; when it became `closed` after that.
  closedAt        DateTime          @default(now()) @map("closed_at") @db.Timestamptz
  registryVersion Json              @map("registry_version") // { dimensions: {key: version}, templates: {...} }
  bqTable         String            @map("bq_table")
  varianceSummary Json              @map("variance_summary")
  /// Why a `failed` closure failed (the sink's error, or who abandoned it).
  error           String?
  envelopes       ClosureEnvelope[]

  @@unique([workspaceId, periodId, closedAt])
  @@map("period_closure")
}

/// Envelopes a closure locked, with the status each had before (restored on restatement unless another closed closure still covers it).
model ClosureEnvelope {
  closureId   String         @map("closure_id") @db.Uuid
  /// W3-11 (audit I-32): both columns of the composite PK were unenforced.
  closure     PeriodClosure  @relation(fields: [closureId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  envelopeId  String         @map("envelope_id") @db.Uuid
  envelope    Envelope       @relation(fields: [envelopeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  priorStatus EnvelopeStatus @map("prior_status")

  @@id([closureId, envelopeId])
  @@index([envelopeId])
  @@map("closure_envelope")
}

model DataSource {
  id               String          @id @db.Uuid
  workspaceId      String          @map("workspace_id") @db.Uuid
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  kind             String // snowflake | sheets | bigquery | csv
  name             String
  config           Json // non-secret config; secretRef points to Secret Manager
  mapping          Json // column → dimension/measure mapping
  schedule         String? // cron
  isActive         Boolean         @default(true) @map("is_active")
  /// T-036: regex with named groups applied to the column mapped as match_key.
  parsePattern     String?         @map("parse_pattern")
  /// D-004: the saved mapping this source takes its mapping from, if any.
  mappingProfileId String?         @map("mapping_profile_id") @db.Uuid
  mappingProfile   MappingProfile? @relation(fields: [mappingProfileId], references: [id], onDelete: Restrict)
  ingestRuns       IngestRun[]

  @@map("data_source")
}

/// D-004 (docs/DATA_PLAN.md §2.3): a named column mapping a workspace reuses.
model MappingProfile {
  id           String       @id @db.Uuid
  workspaceId  String       @map("workspace_id") @db.Uuid
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name         String
  kind         String
  mapping      Json
  parsePattern String?      @map("parse_pattern")
  /// The columns it maps, as the file's header had them (for matching a new file).
  header       String[]
  createdBy    String       @map("created_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @default(now()) @map("updated_at") @db.Timestamptz
  archivedAt   DateTime?    @map("archived_at") @db.Timestamptz
  sources      DataSource[]

  @@unique([workspaceId, name])
  @@map("mapping_profile")
}

/// D-005: the workspace's own words for columns (header → mapping) and metrics (tcpa → cpa).
model MappingSynonym {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  kind        String
  term        String
  target      Json
  origin      String
  uses        Int       @default(1)
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([workspaceId, kind, term])
  @@map("mapping_synonym")
}

/// EX-1 (ADR-0085): facts whose dimension_values satisfy `predicate` (a FilterGroup over fact
/// dimensions) go to `envelope`, inside [startDate, endDate] when set. Beats the tuple match; two
/// rules naming different envelopes for one fact make it ambiguous. Soft-deleted only.
model MatchRule {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  envelopeId  String    @map("envelope_id") @db.Uuid
  envelope    Envelope  @relation(fields: [envelopeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  predicate   Json
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy   String?   @map("deleted_by") @db.Uuid

  @@index([envelopeId], map: "match_rule_envelope")
  @@map("match_rule")
}

/// T-036 (§24.1): how envelopes are named (`display`) and keyed for matching (`match_key`).
model NamingTemplate {
  id           String    @id @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  kind         String // display | match_key
  chips        Json
  casing       String    @default("original")
  whitespace   String    @default("keep")
  stripAccents Boolean   @default(false) @map("strip_accents")
  version      Int       @default(1)
  isActive     Boolean   @default(true) @map("is_active")
  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("naming_template")
}

model IngestRun {
  id             String     @id @db.Uuid
  sourceId       String     @map("source_id") @db.Uuid
  /// W3-11 (audit I-32): was unenforced.
  source         DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  startedAt      DateTime   @default(now()) @map("started_at") @db.Timestamptz
  finishedAt     DateTime?  @map("finished_at") @db.Timestamptz
  status         String     @default("running") // queued | running | ok | failed
  /// W3-4 (audit I-9): set when the run is claimed (queued → running) and refreshed after each
  /// 5,000-row flush; a `running` run whose lease expired is stuck (the worker died) and the
  /// sweeper fails it, converges its partial facts, and re-queues it once.
  leaseUntil     DateTime?  @map("lease_until") @db.Timestamptz
  heartbeatAt    DateTime?  @map("heartbeat_at") @db.Timestamptz
  rowsRead       Int        @default(0) @map("rows_read")
  rowsAccepted   Int        @default(0) @map("rows_accepted")
  rowsRejected   Int        @default(0) @map("rows_rejected")
  errorReportUri String?    @map("error_report_uri")
  formulaVersion String?    @map("formula_version")
  summary        Json       @default("{}") // matchCoverage, matched / unmatched rows, reject reasons, error (spec §24.3), requeuedFrom (W3-4)

  @@index([sourceId, startedAt])
  /// W3-3 (audit I-19): partial unique index ingest_run_source_open_run (source_id) WHERE status
  /// IN ('queued','running') -- not representable as @@unique (no partial-index attribute);
  /// enforced in 20261015010000_partial_unique_constraints/migration.sql.
  @@map("ingest_run")
}

/// T-038 (spec §25.1, plan §4.12): a test budget with a question attached.
model Experiment {
  id            String               @id @db.Uuid
  workspaceId   String               @map("workspace_id") @db.Uuid
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name          String
  hypothesis    String
  kind          ExperimentKind
  testFilter    Json                 @map("test_scope_filter") // FilterGroup
  controlFilter Json?                @map("control_scope_filter") // FilterGroup | null
  /// EX-2 (ADR-086): 'envelope' | 'fact' — what testFilter / controlFilter are evaluated on (CHECK in 20261020020000).
  testScopeKind    String           @default("envelope") @map("test_scope_kind")
  controlScopeKind String           @default("envelope") @map("control_scope_kind")
  primaryMetric String               @map("primary_metric_key")
  criterion     Json                 @map("success_criterion") // { comparator: 'lte'|'gte', value?: string, vs: 'control'|'absolute', minDays?: number }
  startDate     DateTime             @map("start_date") @db.Date
  endDate       DateTime             @map("end_date") @db.Date
  status        ExperimentStatus     @default(PLANNED)
  ownerId       String               @map("owner_id") @db.Uuid
  decision      String?
  decidedBy     String?              @map("decided_by") @db.Uuid
  decidedAt     DateTime?            @map("decided_at") @db.Timestamptz
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  envelopes     ExperimentEnvelope[]

  @@index([workspaceId, status])
  @@map("experiment")
}

model ExperimentEnvelope {
  experimentId String         @map("experiment_id") @db.Uuid
  experiment   Experiment     @relation(fields: [experimentId], references: [id])
  envelopeId   String         @map("envelope_id") @db.Uuid
  workspaceId  String         @map("workspace_id") @db.Uuid
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  role         ExperimentRole

  @@id([experimentId, envelopeId])
  @@index([envelopeId], map: "experiment_envelope_envelope_idx")
  @@map("experiment_envelope")
}

enum ExperimentKind {
  PLATFORM_TEST
  OBJECTIVE_TEST
  AUDIENCE_TEST
  CREATIVE_TEST
  GEO_HOLDOUT
  CUSTOM
}

enum ExperimentStatus {
  PLANNED
  RUNNING
  EVALUATING
  CONCLUDED
  ABANDONED
}

enum ExperimentRole {
  TEST
  CONTROL
}

/// T-039 (spec §26.1, plan §6.1): offline / non-integrated actuals entered by hand, one batch per channel and period.
model ManualEntryBatch {
  id                String            @id @db.Uuid
  workspaceId       String            @map("workspace_id") @db.Uuid
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  channel           String // dimension_value.code of `channel` (tv, ooh, dooh, print, radio, sponsorship, other)
  periodStart       DateTime          @map("period_start") @db.Date
  periodEnd         DateTime          @map("period_end") @db.Date
  status            ManualEntryStatus @default(DRAFT)
  rows              Json              @default("[]") // [{ rowNo, dimensionValues, periodDate, currency, amount, kpis, note? }]
  totals            Json              @default("{}") // { amount, byCurrency, rows }
  approvalRequestId String?           @map("approval_request_id") @db.Uuid
  createdBy         String            @map("created_by") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  submittedAt       DateTime?         @map("submitted_at") @db.Timestamptz
  facts             ManualEntryFact[]

  @@index([workspaceId, status])
  @@map("manual_entry_batch")
}

/// Lineage of the facts an approved batch wrote: who entered and who approved each (spec §26.2).
model ManualEntryFact {
  workspaceId   String           @map("workspace_id") @db.Uuid
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  batchId       String           @map("batch_id") @db.Uuid
  batch         ManualEntryBatch @relation(fields: [batchId], references: [id])
  rowNo         Int              @map("row_no")
  factTable     String           @map("fact_table") // spend_fact | kpi_fact
  metric        String?
  sourceRowHash String           @map("source_row_hash")
  periodDate    DateTime         @map("period_date") @db.Date
  enteredBy     String           @map("entered_by") @db.Uuid
  approvedBy    String           @map("approved_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@id([batchId, sourceRowHash, periodDate])
  @@index([workspaceId, sourceRowHash, periodDate], map: "manual_entry_fact_hash_idx")
  @@map("manual_entry_fact")
}

enum ManualEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

/// T-040 (spec §27): a role's guided tour. workspaceId NULL = the built-in default; a workspace's own row overrides it.
model Tour {
  id          String           @id @db.Uuid
  workspaceId String?          @map("workspace_id") @db.Uuid
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  role        String // planner | approver | finance | data_admin
  name        String
  steps       Json // [{ path?, element: '[data-tour="…"]', title, description }]
  version     Int              @default(1)
  updatedAt   DateTime         @default(now()) @map("updated_at") @db.Timestamptz
  completions TourCompletion[]

  @@map("tour")
}

model TourCompletion {
  userId      String   @map("user_id") @db.Uuid
  tourId      String   @map("tour_id") @db.Uuid
  tour        Tour     @relation(fields: [tourId], references: [id])
  version     Int
  /// Closed before the last step (UX-001): seen, not completed.
  dismissed   Boolean  @default(false)
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz

  @@id([userId, tourId, version])
  @@map("tour_completion")
}

/// T-040 (spec §27): what a new workspace starts from. orgId NULL = built in (default_agency).
model WorkspaceTemplate {
  id                 String   @id @db.Uuid
  orgId              String?  @map("org_id") @db.Uuid
  key                String
  name               String
  description        String?
  registry           Json     @default("[]")
  hierarchyTemplates Json     @default("[]") @map("hierarchy_templates")
  policies           Json     @default("[]")
  rules              Json     @default("[]")
  savedViews         Json     @default("[]") @map("saved_views")
  tours              Json     @default("[]")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("workspace_template")
}

/// How a child budget follows its parent (ADR-039): a % of the parent's amount or its own (manual). One current rule per child.
model EnvelopeAllocation {
  id               String    @id @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  parentEnvelopeId String    @map("parent_envelope_id") @db.Uuid
  parent           Envelope  @relation("AllocationParent", fields: [parentEnvelopeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "envelope_allocation_parent_fkey")
  childEnvelopeId  String    @map("child_envelope_id") @db.Uuid
  child            Envelope  @relation("AllocationChild", fields: [childEnvelopeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "envelope_allocation_child_fkey")
  mode             String
  pct              Decimal?  @db.Decimal(9, 6)
  createdBy        String    @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  supersededAt     DateTime? @map("superseded_at") @db.Timestamptz

  // Partial indexes (current rule per child, by parent) live in the migration's SQL only.
  @@map("envelope_allocation")
}

/// Phase E (ADR-053): a snapshot saved by hand — the workspace, a filter's budgets or one budget's subtree.
model BudgetBaseline {
  id             String              @id @db.Uuid
  workspaceId    String              @map("workspace_id") @db.Uuid
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  name           String
  kind           String // plan | close | other
  scope          Json                @default("{}")
  periodKey      String?             @map("period_key")
  asOf           DateTime            @map("as_of") @db.Timestamptz
  note           String?
  takenBy        String              @map("taken_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  archivedAt     DateTime?           @map("archived_at") @db.Timestamptz
  rowCount       Int                 @map("row_count")
  totalReporting Decimal             @map("total_reporting") @db.Decimal(18, 2)
  rows           BudgetBaselineRow[]

  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
  @@map("budget_baseline")
}

/// One budget as it was when the snapshot was saved: amount and structure. Written once.
model BudgetBaselineRow {
  baselineId      String         @map("baseline_id") @db.Uuid
  /// D-013: a row belongs to its snapshot's workspace (composite key; and to its budget's, in SQL).
  baseline        BudgetBaseline @relation(fields: [baselineId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  workspaceId     String         @map("workspace_id") @db.Uuid
  envelopeId      String         @map("envelope_id") @db.Uuid
  versionId       String?        @map("version_id") @db.Uuid
  amount          Decimal        @db.Decimal(18, 2)
  amountReporting Decimal        @map("amount_reporting") @db.Decimal(18, 2)
  currency        String         @db.Char(3)
  parentId        String?        @map("parent_id") @db.Uuid
  name            String
  dimensionValues Json           @map("dimension_values")
  startDate       DateTime       @map("start_date") @db.Date
  endDate         DateTime       @map("end_date") @db.Date
  isLeaf          Boolean        @map("is_leaf")

  @@id([baselineId, envelopeId])
  @@index([workspaceId, envelopeId])
  @@map("budget_baseline_row")
}

/// W1-5 (ADR-0072): a bulk-edit or budget-import preview staged between preview and commit, so any
/// API instance can commit a preview another instance built. `take` (SQL `DELETE … RETURNING`)
/// consumes it atomically; expired rows are swept opportunistically on the next `put` of their
/// workspace. Never read outside its own request's tenant transaction.
model BulkPreview {
  id          String    @id
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId    String    @map("author_id") @db.Uuid
  kind        String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz

  @@index([workspaceId, expiresAt])
  @@map("bulk_preview")
}

// ---------- Session and MCP refresh-token store (W5-3, audit S-11/S-12) ----------
/// One row per issued session JWT `jti` (migration 20261011000000). Written only through
/// app_create_session/app_revoke_session/app_revoke_all_sessions; budget_app's own SELECT/UPDATE
/// grant (RLS: own rows only) is for a future self-service "your sessions" view.
model AuthSession {
  jti        String    @id
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  orgId      String    @map("org_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  userAgent  String?   @map("user_agent")

  @@index([userId])
  @@map("auth_session")
}

/// A single-use MCP authorization code (ADR-066 addendum): the code itself is still a signed JWT;
/// this row (keyed by a hash of it) is what makes replay within its 5-minute TTL impossible.
model OauthCode {
  codeHash  String    @id @map("code_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz

  @@map("oauth_code")
}

/// One row per issued MCP refresh token `jti` (ADR-066 addendum). No FK to app_user: the row only
/// groups a rotation chain by (userId, clientId) for reuse-detection revocation.
model OauthRefresh {
  jti             String    @id
  clientId        String    @map("client_id")
  userId          String    @map("user_id") @db.Uuid
  chainStartedAt  DateTime  @map("chain_started_at") @db.Timestamptz
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  usedAt          DateTime? @map("used_at") @db.Timestamptz
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz

  @@index([userId, clientId])
  @@map("oauth_refresh")
}

/// W3-2 (audit I-6, spec §17, ADR-0081): one `Idempotency-Key` per (scope, actor, key). Exactly one
/// of workspaceId / orgId / slackTeamId is set (CHECK); the three partial unique indexes on
/// (scope, actor, key) live in the SQL migration (Prisma cannot express them). Read and written
/// only by packages/db/src/idempotency.ts; rows live 24 h.
model IdempotencyKey {
  id          String        @id @db.Uuid
  workspaceId String?       @map("workspace_id") @db.Uuid
  workspace   Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orgId       String?       @map("org_id") @db.Uuid
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  slackTeamId String?       @map("slack_team_id")
  actorId     String?       @map("actor_id") @db.Uuid
  key         String
  route       String
  fingerprint String
  status      Int?
  response    Json?         @db.Json
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  completedAt DateTime?     @map("completed_at") @db.Timestamptz

  @@index([createdAt], map: "idempotency_key_created")
  @@map("idempotency_key")
}
