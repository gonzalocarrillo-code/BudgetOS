# Database connection URLs for local development.
# See .env.example at the repo root for a complete list of all environment variables
# and their descriptions. These four keys are required for all services.

# Local Postgres from docker-compose.yml (spec §2). Placeholder only.
DATABASE_URL=postgresql://budget:budget@localhost:5432/budget
# Application role from migration 0001_roles. Password is the spec placeholder.
APP_DATABASE_URL=postgresql://budget_app:replace-in-secret-manager@localhost:5432/budget
# Outbox publisher role from migration 20260924070000 (ADR-010). Password is the spec placeholder.
PUBLISHER_DATABASE_URL=postgresql://budget_publisher:replace-in-secret-manager@localhost:5432/budget
# Read-only MCP role from migration 20260925020000 (ADR-019). Password is the spec placeholder.
MCP_DATABASE_URL=postgresql://budget_mcp:replace-in-secret-manager@localhost:5432/budget
# GCS emulator from docker-compose (ADR-011). Unset in deployed environments.
GCS_EMULATOR_HOST=http://127.0.0.1:4443
# notify-worker (ADR-015) and the Slack bot (ADR-046, docs/runbooks/slack.md). One Slack app per
# environment; its two credentials come from Secret Manager on GCP. Empty token = no Slack delivery.
# Placeholders only: never commit real values.
SLACK_BOT_TOKEN=
# Verifies Slack's requests to /slack/interactions and /slack/commands. Empty = Slack routes refuse everything.
SLACK_SIGNING_SECRET=
# The API's public URL Slack calls: a tunnel with a static domain on localhost (ngrok http --url=<name>.ngrok-free.app 3000),
# the load balancer on GCP. Shown in Admin › Slack and put in the manifest (pnpm slack:manifest --url …).
API_PUBLIC_URL=
# The web app, for links in Slack messages. The notify worker warns at start when a token is set without it.
APP_BASE_URL=http://localhost:5173
# Closures (ADR-018). Set in deployed environments: the closure sink writes BigQuery dataset
# CLOSURE_DATASET in this project. Unset locally, so POST /closures is 503 outside tests.
GOOGLE_CLOUD_PROJECT=
CLOSURE_DATASET=closures
# Query engine (ADR-042). REDIS_URL caches /query results (in memory without it; QUERY_CACHE=off
# disables). BIGQUERY_DATASET (project.dataset of the warehouse replica) routes heavy grouped
# queries to BigQuery; unset locally, so everything runs on Postgres.
REDIS_URL=
QUERY_CACHE=
BIGQUERY_PROJECT=
BIGQUERY_DATASET=
BIGQUERY_LOCATION=
# Retention (docs/DATA_PLAN.md D-002, docs/runbooks/retention.md). Off unless true: nothing is ever
# deleted locally. Facts are pruned only with BIGQUERY_DATASET set and only for months the replica
# matches exactly. FACT_RETENTION_MONTHS (default 13, never less) is how many months stay hot.
FACT_RETENTION_ENABLED=
FACT_RETENTION_MONTHS=
