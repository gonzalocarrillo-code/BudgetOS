{
  "name": "@budget/grid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.bench.json",
    "test": "vitest run --root . --config ../../vitest.config.mjs",
    "bench": "vitest run --root . --config vitest.bench.config.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir /tmp/budget-grid-storybook"
  },
  "dependencies": {
    "@budget/domain": "workspace:^",
    "@glideapps/glide-data-grid": "6.0.3",
    "decimal.js": "10.6.0",
    "lodash": "4.17.21",
    "marked": "4.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-responsive-carousel": "3.2.23"
  },
  "devDependencies": {
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.13",
    "@tanstack/table-core": "8.21.3",
    "@tanstack/virtual-core": "3.17.11",
    "@types/node": "catalog:",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.21.5",
    "eslint": "catalog:",
    "storybook": "8.6.14",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
