    "@tanstack/virtual-core": "3.17.11",
    "@types/node": "catalog:",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.21.5",
    "eslint": "catalog:",
    "lodash": "4.17.21",
    "marked": "4.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-responsive-carousel": "3.2.23",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
