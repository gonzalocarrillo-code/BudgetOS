# Budget OS — Environment variables
#
# See packages/domain/src/env.ts for schemas, defaults and required vs optional per service.
# Secret Manager names below are from deploy.yml; locals use the listed placeholders.
# Unset = feature disabled or defaults apply; empty string = intentionally off.

# --- Common (all services) ---

# NODE_ENV: set by Node/Cloud Run, used for defaults (development or production)

# LOG_LEVEL: pino level (fatal/error/warn/info/debug/trace); defaults to info
LOG_LEVEL=info

# GOOGLE_CLOUD_PROJECT: GCP project ID for BigQuery replica and GCS uploads
GOOGLE_CLOUD_PROJECT=

# UPLOAD_BUCKET: GCS bucket for CSV/Snapshot exports; production: dmus-gonzalo-budgetos-uploads
UPLOAD_BUCKET=

# CLOSURE_DATASET: BigQuery dataset for period closures; production: budgetos_closures
CLOSURE_DATASET=closures

# CLOSURE_SINK: BigQuery load job sink; production only
CLOSURE_SINK=

# API_PUBLIC_URL: API's public URL that Slack calls; production only (load balancer)
API_PUBLIC_URL=

# APP_BASE_URL: Web app URL for links in Slack messages; production and local with Slack
APP_BASE_URL=http://localhost:5173

# MCP_PUBLIC_URL: MCP server's public URL for OAuth redirect; production only with MCP_OAUTH_KEY
MCP_PUBLIC_URL=

# REDIS_URL: Redis for /query result cache; optional, defaults to in-memory
REDIS_URL=

# QUERY_CACHE: Cache mode (on/off); defaults to on when REDIS_URL is set
QUERY_CACHE=

# BIGQUERY_PROJECT: BigQuery project ID for data warehouse replica
BIGQUERY_PROJECT=

# BIGQUERY_DATASET: BigQuery dataset (project.dataset) of warehouse replica; routes heavy queries to BQ
BIGQUERY_DATASET=

# BIGQUERY_LOCATION: BigQuery location (us-central1, etc.)
BIGQUERY_LOCATION=

# FACT_RETENTION_ENABLED: Enable fact pruning (true/false); defaults to false
FACT_RETENTION_ENABLED=

# FACT_RETENTION_MONTHS: Hot fact months (minimum 7, default 13)
FACT_RETENTION_MONTHS=13

# GCS_EMULATOR_HOST: GCS emulator endpoint; local only (from docker-compose)
GCS_EMULATOR_HOST=http://127.0.0.1:4443

# --- Database connections ---
# See packages/db/.env.example for connection string format and roles.
# All use Postgres 16; role passwords come from Secret Manager in production.
# Locals use the migration placeholders with docker-compose port 5432.

# DATABASE_URL: owner role (W0-6: non-superuser, NOBYPASSRLS, CREATEROLE, CREATEDB, like
# production's owner; created locally by scripts/db-init.sql). Runs migrations, seed and
# bootstrap.ts. Never the owner's old standing bypass — see 20261010050000_owner_bootstrap_policies.
# Secret Manager: budgetos-database-url
DATABASE_URL=postgresql://budget_owner:budget_owner@localhost:5432/budget

# APP_DATABASE_URL: application role (select/insert/update on tenant tables)
# Secret Manager: budgetos-app-database-url (required)
APP_DATABASE_URL=postgresql://budget_app:replace-in-secret-manager@localhost:5432/budget

# PUBLISHER_DATABASE_URL: outbox publisher role (read outbox, write audit and publish)
# Secret Manager: budgetos-database-url (W2-3: API workers use this instead of DATABASE_URL)
PUBLISHER_DATABASE_URL=postgresql://budget_publisher:replace-in-secret-manager@localhost:5432/budget

# MCP_DATABASE_URL: read-only MCP role (select on auditable tables)
# Secret Manager: budgetos-mcp-database-url
MCP_DATABASE_URL=postgresql://budget_mcp:replace-in-secret-manager@localhost:5432/budget

# --- API (apps/api) ---

PORT=3000
LISTEN_HOST=0.0.0.0

# WEB_HOST, WEB_PORT: Vite dev server (local only, pnpm dev)
WEB_HOST=localhost
WEB_PORT=5173
WEB_DIST=apps/web/dist

# AUTH_MODE: sign-in mode (iap or session)
# - iap: Google IAP assertion (Cloud Run); AUTH_AUDIENCE is required
# - session: OAuth + session cookies; SESSION_KEY and OAuth secrets are required
AUTH_MODE=iap

# AUTH_AUDIENCE: IAP service URL (/projects/PROJECT_NUMBER/locations/REGION/services/budgetos-app)
# Required when AUTH_MODE=iap; set in production via deploy.yml
AUTH_AUDIENCE=

# AUTH_ISSUER: OIDC issuer (defaults to https://accounts.google.com)
AUTH_ISSUER=

# AUTH_JWKS_URL: OIDC JWKS endpoint (defaults to Google's)
AUTH_JWKS_URL=

# GOOGLE_OAUTH_CLIENT_ID: Google OAuth app client ID
# Secret Manager: budgetos-google-oauth-client-id (if session mode is enabled)
GOOGLE_OAUTH_CLIENT_ID=

# GOOGLE_OAUTH_CLIENT_SECRET: Google OAuth app client secret
# Secret Manager: budgetos-google-oauth-client-secret (if session mode is enabled)
GOOGLE_OAUTH_CLIENT_SECRET=

# SESSION_KEY: HMAC key for session signing
# Secret Manager: budgetos-session-key (session mode only)
SESSION_KEY=

# SUPERADMIN_EMAIL: superadmin email for bootstrap; set via deploy.yml
SUPERADMIN_EMAIL=

# SUPERADMIN_NAME: superadmin name for bootstrap; defaults to email prefix
SUPERADMIN_NAME=

# MCP_OAUTH_KEY: MCP server OAuth signing key
# Secret Manager: budgetos-mcp-oauth-key
MCP_OAUTH_KEY=

# --- Integrations ---

# OPENAI_API_KEY: OpenAI API key (if AI features are enabled)
# Secret Manager: budgetos-openai-api-key
OPENAI_API_KEY=

# OPENAI_MODEL: OpenAI model ID (defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# SLACK_BOT_TOKEN: Slack bot token (if Slack is enabled)
# Secret Manager: budgetos-slack-bot-token
SLACK_BOT_TOKEN=

# SLACK_SIGNING_SECRET: Slack app signing secret
# Secret Manager: budgetos-slack-signing-secret
SLACK_SIGNING_SECRET=

# --- Local development ---

# LOCAL_PERSONA: simulate user role (admin/member); local only
LOCAL_PERSONA=

# LOCAL_ORG_FROM: local org to serve; defaults to 'local'
LOCAL_ORG_FROM=local

# LOCAL_WORKSPACE_PREFIX: local workspace prefix filter; defaults to 'e2e-'
LOCAL_WORKSPACE_PREFIX=e2e-

# LOAD_KEEP: keep test load data; local only
LOAD_KEEP=

# SEED_SLUG: workspace slug to seed; local only
SEED_SLUG=

# PUBLIC_ROUTES: routes behind IAP (none = all behind IAP)
PUBLIC_ROUTES=

# UPDATE_OPENAPI: regenerate openapi.json on startup; local dev only
UPDATE_OPENAPI=

# SNAPSHOT_INTEGRITY: enable snapshot integrity checks; local only
SNAPSHOT_INTEGRITY=

# IAP_DEBUG: log IAP assertion details; local testing only
IAP_DEBUG=

# --- Testing ---

# VITEST: set by vitest runner
VITEST=

# BENCH_RECORD: record benchmark results; test only
BENCH_RECORD=

# PERF_BUDGET_SCALE: benchmark scale factor for slower CI; test only
PERF_BUDGET_SCALE=

# JWKS_PERSIST: persist JWKS cache; test only
JWKS_PERSIST=

# K_SERVICE: Cloud Run service name; set by Cloud Run
K_SERVICE=

# E2E_PORT_OFFSET: port offset for E2E tests; test only
E2E_PORT_OFFSET=

# E2E_PROFILE: Playwright profile; test only
E2E_PROFILE=
