{
  "openapi": "3.0.3",
  "info": {
    "title": "Budget OS",
    "version": "0.5.0"
  },
  "components": {
    "securitySchemes": {
      "identityPlatform": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Identity Platform ID token"
      }
    }
  },
  "security": [
    {
      "identityPlatform": []
    }
  ],
  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "Caller, roles per workspace and permissions"
          }
        }
      }
    },
    "/api/v1/workspaces/{ws}/roles": {
      "get": {
        "operationId": "listRoleAssignments",
        "parameters": [
          {
            "name": "ws",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Role assignments in the workspace"
          }
        }
      },
      "post": {
        "operationId": "assignRole",
        "parameters": [
          {
            "name": "ws",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "principalType": {
                    "type": "string",
                    "enum": [
                      "user",
                      "group"
                    ]
                  },
                  "principalId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "VIEWER",
                      "PLANNER",
                      "BUDGET_OWNER",
                      "APPROVER",
                      "FINANCE",
                      "DATA_ADMIN",
                      "WORKSPACE_ADMIN"
                    ]
                  },
                  "scope": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "logic": {
                            "type": "string",
                            "enum": [
                              "and",
                              "or"
                            ]
                          },
                          "not": {
                            "type": "boolean"
                          },
                          "children": {
                            "type": "array",
                            "maxItems": 50,
                            "items": {
                              "oneOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "field": {
                                      "type": "object",
                                      "properties": {
                                        "kind": {
                                          "type": "string",
                                          "enum": [
                                            "dimension"
                                          ]
                                        },
                                        "key": {
                                          "type": "string",
                                          "minLength": 1
                                        }
                                      },
                                      "required": [
                                        "kind",
                                        "key"
                                      ]
                                    },
                                    "op": {
                                      "type": "string",
                                      "enum": [
                                        "eq",
                                        "in",
                                        "descends_from"
                                      ]
                                    },
                                    "value": {
                                      "oneOf": [
                                        {
                                          "type": "string",
                                          "minLength": 1
                                        },
                                        {
                                          "type": "array",
                                          "minItems": 1,
                                          "items": {
                                            "type": "string",
                                            "minLength": 1
                                          }
                                        }
                                      ]
                                    }
                                  },
                                  "required": [
                                    "field",
                                    "op",
                                    "value"
                                  ]
                                },
                                {}
                              ]
                            }
                          }
                        },
                        "required": [
                          "logic",
                          "children"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {}
                      }
                    ],
                    "default": {}
                  }
                },
                "required": [
                  "principalType",
                  "principalId",
                  "role"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created role assignment"
          }
        }
      }
    },
    "/api/v1/roles/{id}": {
      "delete": {
        "operationId": "revokeRole",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Workspace-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revoked role assignment"
          }
        }
      }
    },
    "/api/v1/workspaces/{ws}/envelopes": {
      "post": {
        "operationId": "createEnvelope",
        "parameters": [
          {
            "name": "ws",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "parentId": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true,
                    "default": null
                  },
                  "dimensionValues": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "startDate": {
                    "type": "string"
                  },
                  "endDate": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "ownerId": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true,
                    "default": null
                  },
                  "periodId": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true,
                    "default": null
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^-?\\d{1,16}(\\.\\d{1,2})?$"
                  },
                  "phasing": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "month": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "string",
                          "pattern": "^-?\\d{1,16}(\\.\\d{1,2})?$"
                        }
                      },
                      "required": [
                        "month",
                        "amount"
                      ]
                    }
                  },
                  "rationale": {
                    "type": "string",
                    "maxLength": 4000
                  }
                },
                "required": [
                  "name",
                  "dimensionValues",
                  "startDate",
                  "endDate",
                  "currency"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created envelope (with v1 draft when an amount is given)"
          }
        }
      }
    },
    "/api/v1/envelopes/{id}": {
      "get": {
        "operationId": "getEnvelope",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Workspace-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Envelope with its approved version and open draft"
          }
        }
      },
      "patch": {
        "operationId": "updateEnvelope",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Workspace-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rowVersion": {
                    "type": "integer",
                    "minimum": 1,
                    "exclusiveMinimum": false
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "ownerId": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  },
                  "startDate": {
                    "type": "string"
                  },
                  "endDate": {
                    "type": "string"
                  },
                  "periodId": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  }
                },
                "required": [
                  "rowVersion"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated envelope metadata"
          },
          "409": {
            "description": "Stale rowVersion; details carry currentRowVersion and currentVersionId"
          }
        }
      }
    },
    "/api/v1/envelopes/{id}/versions": {
      "get": {
        "operationId": "listEnvelopeVersions",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Workspace-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "All versions, newest first"
          }
        }
      }
    },
    "/api/v1/envelopes/{id}/draft": {
      "patch": {
        "operationId": "createDraftVersion",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Workspace-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "string",
                    "pattern": "^-?\\d{1,16}(\\.\\d{1,2})?$"
                  },
                  "rationale": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "phasing": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "month": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "string",
                          "pattern": "^-?\\d{1,16}(\\.\\d{1,2})?$"
                        }
                      },
                      "required": [
                        "month",
                        "amount"
                      ]
                    }
                  },
                  "basedOnVersionId": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  },
                  "attachments": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "gcsUri": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "sha256": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "gcsUri",
                        "name",
                        "sha256"
                      ]
                    },
                    "default": []
                  }
                },
                "required": [
                  "amount",
                  "basedOnVersionId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New draft version"
          },
          "409": {
            "description": "Stale basedOnVersionId; details.currentVersionId"
          },
          "423": {
            "description": "Period closed"
          }
        }
      }
    },
    "/api/v1/envelopes/{id}/phasing": {
      "patch": {
        "operationId": "updateEnvelopePhasing",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Workspace-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phasing": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "month": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "string",
                          "pattern": "^-?\\d{1,16}(\\.\\d{1,2})?$"
                        }
                      },
                      "required": [
                        "month",
                        "amount"
                      ]
                    }
                  },
                  "basedOnVersionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "rationale": {
                    "type": "string",
                    "maxLength": 4000
                  }
                },
                "required": [
                  "phasing",
                  "basedOnVersionId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New draft version with the same amount and new phasing"
          }
        }
      }
    },
    "/api/v1/envelopes/{id}/restore/{versionId}": {
      "post": {
        "operationId": "restoreEnvelopeVersion",
