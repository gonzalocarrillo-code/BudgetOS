          }
        }
      }
    },
    "/api/v1/workspaces/{ws}/dimensions": {
      "get": {
        "operationId": "listDimensions",
        "parameters": [
          {
            "name": "ws",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Registry dimensions visible to the workspace"
          }
        }
      },
      "post": {
        "operationId": "createDimension",
        "parameters": [
          {
            "name": "ws",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{1,40}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "dataType": {
                    "type": "string",
                    "enum": [
                      "ENUM",
                      "TEXT",
                      "REFERENCE",
                      "DATE_BUCKET"
                    ]
                  },
                  "icon": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "color": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "allowedParents": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{1,40}$"
                    },
                    "default": []
                  },
                  "isRequiredForLeaf": {
                    "type": "boolean",
                    "default": false
                  },
                  "sortOrder": {
                    "type": "integer",
                    "default": 0
                  },
                  "workspaceId": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  }
                },
                "required": [
                  "key",
                  "label",
                  "dataType",
                  "icon",
                  "workspaceId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created dimension"
          }
        }
      }
    },
    "/api/v1/dimensions/{id}": {
      "patch": {
        "operationId": "updateDimension",
