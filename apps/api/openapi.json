                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "members": {
                          "type": "array",
                          "maxItems": 10000,
                          "items": {
                            "type": "string",
                            "format": "email"
                          }
                        }
                      },
                      "required": [
                        "googleGroup",
                        "name",
                        "members"
                      ]
                    }
                  }
                },
                "required": [
                  "groups"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
