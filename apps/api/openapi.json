            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Workspace-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "basedOnVersionId": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  },
                  "rationale": {
                    "type": "string",
                    "maxLength": 4000
                  }
                },
                "required": [
                  "basedOnVersionId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New draft version copied from the given version"
          }
        }
      }
    },
    "/api/v1/workspaces/{ws}/groups/sync": {
      "post": {
