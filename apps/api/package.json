{
  "name": "@budget/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/main.ts",
    "./queries": "./src/queries.ts",
    "./auth": "./src/common/auth/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root . --config vitest.config.mjs",
    "test:acceptance": "vitest run --root . --config vitest.config.mjs src/modules/registry/epic-0.4.acceptance.test.ts src/modules/approvals/epic-1.3.acceptance.test.ts src/modules/envelopes/epic-1.4.acceptance.test.ts",
    "seed:golden": "tsx src/seed/golden.ts",
    "dev": "tsx src/main.ts"
  },
  "devDependencies": {
    "@google-cloud/storage": "8.2.0",
    "@types/node": "22.20.4",
    "eslint": "catalog:",
    "exceljs": "4.4.0",
    "tsx": "4.20.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@budget/ai": "workspace:^",
    "@budget/db": "workspace:^",
    "@budget/domain": "workspace:^",
    "@budget/query-planner": "workspace:^",
    "@budget/workers": "workspace:^",
    "@google-cloud/bigquery": "9.1.0",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-fastify": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.3",
    "@redis/client": "6.2.1",
    "decimal.js": "10.6.0",
    "dompurify": "3.4.16",
    "jose": "6.2.12",
    "jsdom": "30.1.1",
    "lucide": "1.48.0",
    "nestjs-zod": "5.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "svgo": "4.1.0",
    "zod": "3.25.76"
  }
}
